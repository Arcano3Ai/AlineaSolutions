# =============================================
# Arancelar IA — Variables de Entorno
# Copiar este archivo a .env y completar con valores reales.
# NUNCA commitear el archivo .env al repositorio.
# =============================================

# --- Clasificación por IA ---
# Usar Gemini (recomendado) o OpenAI, no ambos simultáneamente.
# Si se define GEMINI_API_KEY, tiene prioridad sobre OPENAI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Google Cloud Platform ---
# Necesario para Google Secret Manager y Google Cloud Storage.
# Si no se define, la bóveda opera en modo local (AES-256-GCM).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name

# --- Configuración de la aplicación ---
# Entorno de ejecución: development | production
FLASK_ENV=development
# Puerto del servidor Flask (local). Cloud Run usa PORT=8080.
PORT=5000
# Desactivar validaciones de producción en modo desarrollo
VUCEM_SIMULATION_MODE=true
